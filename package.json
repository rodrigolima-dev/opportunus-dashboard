{
  "name": "opportunus-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:http": "node tests/http-smoke.mjs",
    "security:secrets": "node scripts/scan-tracked-secrets.mjs",
    "security:history": "node scripts/scan-tracked-secrets.mjs --git-history"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "postcss": "8.5.25"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "typescript": "^5.9.3"
  }
}
